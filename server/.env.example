# Copy this file to "server/.env" for local development, and add the same keys in
# Render → your service → Environment for production. Never commit the real .env.

# --- Supabase (Dashboard → Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "service_role" / secret key. SERVER ONLY — never put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# "anon" / publishable key (public by design; used for direct browser uploads)
SUPABASE_ANON_KEY=

# --- Auth ---
# Long random string, e.g. generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Server ---
PORT=5000
NODE_ENV=development
# Comma-separated list of frontend URLs allowed to call the API (leave empty locally)
CLIENT_URLS=https://your-site.vercel.app

# --- Optional ---
# Max video size in MB (50 = Supabase free plan limit; raise after upgrading)
MAX_VIDEO_MB=50
# Storage bucket name (created by database/schema.sql)
SUPABASE_STORAGE_BUCKET=uploads
YOUTUBE_API_KEY=
